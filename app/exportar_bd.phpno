<?php 

set_time_limit(0);
$mysqliold = new mysqli(
    "localhost",     
    "tecnol64_tecnol64",                 
    "dIz9Dy6Ni!J11(",           
    "tecnol64_talleres2026"         
);
$mysqliold->set_charset("utf8");

if ($mysqliold->connect_errno) {
    die("Error al conectar con la BD vieja: " . $mysqliold->connect_error);
}
require('conexion.php');

$ok = 0;
$error = 0;

echo "<h2>DOCENTES</h2>";

$get_docente = $mysqliold->query("SELECT * FROM docentes");

while ($d = $get_docente->fetch_assoc()) {

    $existe = $mysqli->query("SELECT id_docente FROM docentes WHERE id_docente = '{$d['id_docente']}'");

    if ($existe->num_rows > 0) {
        echo " Repetido ID: {$d['id_docente']}<br><hr>";
        continue;
    }

    $insert = $mysqli->query("INSERT INTO docentes 
    (id_docente,num_empleado,nombre, rol, telefono, correo, password, status, codigo) 
    VALUES 
    ('{$d['id_docente']}','{$d['num_empleado']}','{$d['nombre']}', '{$d['rol']}', '{$d['telefono']}', '{$d['correo']}', '{$d['password']}', '{$d['status']}', '{$d['codigo']}')");

    if ($insert) { echo " OK<br>"; $ok++; } 
    else { echo " ".$mysqli->error."<br>"; $error++; }

    echo "<hr>";
}

echo "<h2>ALUMNOS</h2>";


echo "<h2>TALLERES</h2>";

$get_talleres = $mysqliold->query("SELECT * FROM talleres");

while ($t = $get_talleres->fetch_assoc()) {

    $existeT = $mysqli->query("SELECT id_taller FROM talleres WHERE id_taller = '{$t['id_taller']}'");

    if ($existeT->num_rows > 0) {
        echo " Repetido ID: {$t['id_taller']}<br><hr>";
        continue;
    }

    $existeD = $mysqli->query("SELECT id_docente FROM docentes WHERE id_docente = '{$t['docente_id']}'");

    if ($existeD->num_rows == 0) {
        echo " Docente no existe: {$t['docente_id']}<br><hr>";
        $error++;
        continue;
    }

    $fecha = date("y-m-d");

    $insert = $mysqli->query("INSERT INTO talleres
    (id_taller, nombre_taller, docente_id, hora, dia, periodo, grupo, cantidad_inscritos, anio, status, fecha_limite, comentarios, limite_liberacion)
    VALUES
    ('{$t['id_taller']}','{$t['nombre_taller']}', '{$t['docente_id']}', '{$t['hora']}',
     '{$t['dia']}', '{$t['periodo']}', '{$t['grupo']}',
     '{$t['cantidad_inscritos']}', '{$t['anio']}',
     '{$t['status']}', '{$t['fecha_limite']}', '{$t['comentarios']}', '$fecha')");

    if ($insert) { echo " OK<br>"; $ok++; } 
    else { echo " ".$mysqli->error."<br>"; $error++; }

    echo "<hr>";
}

echo "<h2>INSCRIPCIONES</h2>";

$get_inscripciones = $mysqliold->query("SELECT * FROM inscripciones");

while ($i = $get_inscripciones->fetch_assoc()) {

    $existe = $mysqli->query("SELECT id_inscripcion FROM inscripciones WHERE id_inscripcion = '{$i['id_inscripcion']}'");

    if ($existe->num_rows > 0) {
        echo "⚠Repetido ID: {$i['id_inscripcion']}<br><hr>";
        continue;
    }

    $insert = $mysqli->query("INSERT INTO inscripciones
    (id_inscripcion, id_alumno, id_docente, id_taller, anio, status_liberado, status, nivel) 
    VALUES
    ('{$i['id_inscripcion']}','{$i['id_alumno']}', '{$i['id_docente']}', '{$i['id_taller']}', '{$i['anio']}', '{$i['status_liberado']}', '{$i['status']}', '{$i['nivel']}')");

    if ($insert) { echo " OK<br>"; $ok++; } 
    else { echo " ".$mysqli->error."<br>"; $error++; }

    echo "<hr>";
}


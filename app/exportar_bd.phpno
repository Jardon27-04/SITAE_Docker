    VALUES 
    ('{$a['id_alumno']}','{$a['nombre_alumno']}', '{$a['curp']}', '{$a['matricula']}', '{$a['cuatrimestre']}', '{$a['grupo']}', '{$a['carrera']}','{$a['telefono']}', '{$a['correo']}', '{$a['password']}', '{$a['nivel']}','{$a['codigo']}','{$a['status']}')");

    if ($insert) { echo " OK<br>"; $ok++; } 
    else { echo " ".$mysqli->error."<br>"; $error++; }

